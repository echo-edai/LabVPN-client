{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LabVPN",
  "version": "0.1.15",
  "identifier": "app.labvpn.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LabVPN",
        "width": 1200,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 660,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "decorations": true,
        "transparent": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "binaries/mihomo": "bin/mihomo",
      "binaries/mihomo.exe": "bin/mihomo.exe",
      "binaries/labvpn-helper": "bin/labvpn-helper",
      "binaries/labvpn-helper.exe": "bin/labvpn-helper.exe",
      "binaries/fdu-connect": "bin/fdu-connect",
      "binaries/fdu-connect.exe": "bin/fdu-connect.exe",
      "binaries/wintun.dll": "bin/wintun.dll",
      "licenses/AGPL-3.0.txt": "licenses/AGPL-3.0.txt",
      "licenses/fdu-connect-NOTICE.txt": "licenses/fdu-connect-NOTICE.txt",
      "binaries/GeoSite.dat": "bin/GeoSite.dat",
      "binaries/geoip.metadb": "bin/geoip.metadb"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    }
  }
}
