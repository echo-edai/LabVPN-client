diff --git a/service/graceful.go b/service/graceful.go
new file mode 100644
index 0000000..1b79174
--- /dev/null
+++ b/service/graceful.go
@@ -0,0 +1,263 @@
+package service
+
+import (
+	"context"
+	"net"
+	"sync"
+	"time"
+
+	"github.com/akirasalvare/fdu-connect/dial"
+	"github.com/akirasalvare/fdu-connect/log"
+)
+
+// gracefulConn is a net.Conn proxy that is handed back to the SOCKS5 server
+// before the upstream connection is fully established.
+//
+// Why: the RVPN tunnel builds a full TCP handshake in a user-space gVisor
+// stack. When an intranet host (or the path towards it) is temporarily lossy,
+// that handshake can take far longer than the SOCKS5 client's own dial
+// timeout (mihomo gives up after 5s), so every such connection is reported as
+// "context deadline exceeded" and never gets a chance to succeed even though
+// the tunnel would have established it a few seconds later.
+//
+// Read/Write block until the real connection is ready, so no data is lost or
+// reordered; Close cancels the in-flight dial (gVisor's DialContextTCP honours
+// the context, so no goroutine is leaked).
+type gracefulConn struct {
+	ctx     context.Context
+	cancel  context.CancelFunc
+	dialer  *dial.Dialer
+	network string
+	addr    string
+	ready   chan struct{}
+
+	mu            sync.Mutex
+	conn          net.Conn
+	err           error
+	closed        bool
+	readDeadline  time.Time
+	writeDeadline time.Time
+
+	// connectTimeout is the total budget for all connection attempts (0 = no
+	// limit and a single attempt). perAttempt bounds each individual attempt so
+	// a wedged handshake can be replaced by a fresh one (new source port and a
+	// new server-side NAT entry), which is what actually recovers from the
+	// short RVPN stalls seen in the logs.
+	connectTimeout time.Duration
+	perAttempt     time.Duration
+}
+
+func newGracefulConn(ctx context.Context, d *dial.Dialer, network, addr string, connectTimeout time.Duration) *gracefulConn {
+	ctx, cancel := context.WithCancel(ctx)
+	perAttempt := time.Duration(0)
+	if connectTimeout > 0 {
+		perAttempt = connectAttemptTimeout
+		if connectTimeout < perAttempt {
+			perAttempt = connectTimeout
+		}
+	}
+	c := &gracefulConn{
+		ctx:            ctx,
+		cancel:         cancel,
+		dialer:         d,
+		network:        network,
+		addr:           addr,
+		ready:          make(chan struct{}),
+		connectTimeout: connectTimeout,
+		perAttempt:     perAttempt,
+	}
+	go c.run()
+	return c
+}
+
+// connectAttemptTimeout bounds one gVisor handshake attempt. It has to be well
+// below the total budget so a wedged attempt can be retried with a fresh one.
+const connectAttemptTimeout = 4 * time.Second
+
+func (c *gracefulConn) run() {
+	var conn net.Conn
+	var err error
+	deadline := time.Time{}
+	if c.connectTimeout > 0 {
+		deadline = time.Now().Add(c.connectTimeout)
+	}
+	for attempt := 1; ; attempt++ {
+		attemptCtx, cancel := c.ctx, context.CancelFunc(func() {})
+		if c.perAttempt > 0 {
+			timeout := c.perAttempt
+			if remain := time.Until(deadline); remain < timeout {
+				timeout = remain
+			}
+			if timeout <= 0 {
+				break
+			}
+			attemptCtx, cancel = context.WithTimeout(c.ctx, timeout)
+		}
+		conn, err = c.dialer.DialIPPort(attemptCtx, c.network, c.addr)
+		cancel()
+		if err == nil {
+			break
+		}
+		if c.ctx.Err() != nil {
+			break
+		}
+		if !deadline.IsZero() && !time.Now().Before(deadline) {
+			break
+		}
+		log.Printf("SOCKS5: %s -> %s attempt %d failed (%v), retrying", c.network, c.addr, attempt, err)
+		select {
+		case <-time.After(200 * time.Millisecond):
+		case <-c.ctx.Done():
+		}
+	}
+	if err != nil {
+		// gonet.DialContextTCP returns (nil *TCPConn, err); converting that to
+		// net.Conn yields a non-nil interface holding a nil pointer, which
+		// would panic on Close. Normalise it before publishing the result.
+		conn = nil
+	}
+	c.mu.Lock()
+	c.conn, c.err = conn, err
+	closed := c.closed
+	if conn != nil {
+		if !c.readDeadline.IsZero() {
+			_ = conn.SetReadDeadline(c.readDeadline)
+		}
+		if !c.writeDeadline.IsZero() {
+			_ = conn.SetWriteDeadline(c.writeDeadline)
+		}
+	}
+	c.mu.Unlock()
+	if closed && conn != nil {
+		_ = conn.Close()
+	}
+	close(c.ready)
+}
+
+// wait blocks until the upstream dial finishes and returns its result.
+func (c *gracefulConn) wait() (net.Conn, error) {
+	<-c.ready
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.conn, c.err
+}
+
+func (c *gracefulConn) Read(p []byte) (int, error) {
+	conn, err := c.wait()
+	if err != nil {
+		return 0, err
+	}
+	return conn.Read(p)
+}
+
+func (c *gracefulConn) Write(p []byte) (int, error) {
+	conn, err := c.wait()
+	if err != nil {
+		return 0, err
+	}
+	return conn.Write(p)
+}
+
+func (c *gracefulConn) Close() error {
+	c.mu.Lock()
+	if c.closed {
+		c.mu.Unlock()
+		return nil
+	}
+	c.closed = true
+	c.mu.Unlock()
+
+	// Cancel the in-flight dial (no-op once it finished) and close the real
+	// connection if it is already available.
+	c.cancel()
+	c.mu.Lock()
+	conn := c.conn
+	c.mu.Unlock()
+	if conn != nil {
+		return conn.Close()
+	}
+	return nil
+}
+
+func (c *gracefulConn) LocalAddr() net.Addr {
+	c.mu.Lock()
+	conn := c.conn
+	c.mu.Unlock()
+	if conn != nil {
+		return conn.LocalAddr()
+	}
+	// Must be a valid IPv4 (not the zero-value TCPAddr with a nil IP):
+	// go-socks5 serialises it into the SOCKS5 reply, and a nil IP would make
+	// the reply 4 bytes short, so clients would block waiting for the rest
+	// until their own dial timeout fires.
+	return &net.TCPAddr{IP: net.IPv4zero}
+}
+
+func (c *gracefulConn) RemoteAddr() net.Addr {
+	return &net.TCPAddr{IP: net.IPv4zero}
+}
+
+func (c *gracefulConn) SetDeadline(t time.Time) error {
+	return c.SetReadDeadline(t)
+}
+
+func (c *gracefulConn) SetReadDeadline(t time.Time) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.readDeadline = t
+	if c.conn != nil {
+		return c.conn.SetReadDeadline(t)
+	}
+	return nil
+}
+
+func (c *gracefulConn) SetWriteDeadline(t time.Time) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.writeDeadline = t
+	if c.conn != nil {
+		return c.conn.SetWriteDeadline(t)
+	}
+	return nil
+}
+
+// dialWithGrace starts dialing and either returns the real net.Conn (fast
+// path, identical to the old behaviour) or, when the handshake is slower than
+// `earlyReply`, a gracefulConn that keeps dialing in the background and blocks
+// on first use. This keeps the SOCKS5 reply inside the client's dial timeout
+// while still letting the tunnel take its time.
+func dialWithGrace(ctx context.Context, d *dial.Dialer, network, addr string, connectTimeout, earlyReply time.Duration) (net.Conn, error) {
+	if connectTimeout <= 0 && earlyReply <= 0 {
+		return d.DialIPPort(ctx, network, addr)
+	}
+
+	c := newGracefulConn(ctx, d, network, addr, connectTimeout)
+	if earlyReply <= 0 {
+		conn, err := c.wait()
+		c.cancel()
+		if err != nil {
+			_ = c.Close()
+			return nil, err
+		}
+		return conn, nil
+	}
+
+	timer := time.NewTimer(earlyReply)
+	defer timer.Stop()
+	select {
+	case <-c.ready:
+		conn, err := c.wait()
+		c.cancel()
+		if err != nil {
+			_ = c.Close()
+			return nil, err
+		}
+		return conn, nil
+	case <-timer.C:
+		log.Printf(
+			"SOCKS5: %s -> %s still connecting after %s, replying and waiting up to %s",
+			network, addr, earlyReply, connectTimeout,
+		)
+		return c, nil
+	}
+}
diff --git a/service/graceful_test.go b/service/graceful_test.go
new file mode 100644
index 0000000..118a9c6
--- /dev/null
+++ b/service/graceful_test.go
@@ -0,0 +1,239 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"net"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/akirasalvare/fdu-connect/dial"
+	"github.com/akirasalvare/fdu-connect/internal/zcdns"
+)
+
+// fakeStack simulates the user-space RVPN stack: a TCP "handshake" that can be
+// fast, slow, failing or cancelled by the context.
+type fakeStack struct {
+	delay time.Duration
+	err   error
+	// typedNilWithErr mimics gonet.DialContextTCP, which returns a typed nil
+	// *gonet.TCPConn together with an error.
+	typedNilWithErr bool
+}
+
+func (f *fakeStack) Run()                             {}
+func (f *fakeStack) SetupResolve(_ zcdns.LocalServer) {}
+
+func (f *fakeStack) DialTCPContext(ctx context.Context, addr *net.TCPAddr) (net.Conn, error) {
+	client, server := net.Pipe()
+	select {
+	case <-time.After(f.delay):
+		if f.typedNilWithErr {
+			_ = client.Close()
+			_ = server.Close()
+			var typedNil *net.TCPConn
+			return typedNil, errors.New("dial failed after partial handshake")
+		}
+		if f.err != nil {
+			_ = client.Close()
+			_ = server.Close()
+			return nil, f.err
+		}
+		// Simulate the first byte arriving from the remote host (e.g. the SSH
+		// banner) so the deferred connection can be read by the tests.
+		go func() {
+			_, _ = server.Write([]byte{'x'})
+		}()
+		return client, nil
+	case <-ctx.Done():
+		_ = client.Close()
+		_ = server.Close()
+		return nil, ctx.Err()
+	}
+}
+
+func (f *fakeStack) DialTCP(addr *net.TCPAddr) (net.Conn, error) {
+	return f.DialTCPContext(context.Background(), addr)
+}
+
+func (f *fakeStack) DialUDP(addr *net.UDPAddr) (net.Conn, error) { return nil, errors.New("no udp") }
+
+func newTestDialer(delay time.Duration, err error) *dial.Dialer {
+	// alwaysUseVPN = true forces the stack path, which is what the SOCKS5 server
+	// uses for intranet destinations.
+	return dial.NewDialer(&fakeStack{delay: delay, err: err}, nil, nil, true, "")
+}
+
+func TestDialWithGraceFastPathReturnsRealConn(t *testing.T) {
+	d := newTestDialer(20*time.Millisecond, nil)
+	conn, err := dialWithGrace(context.Background(), d, "tcp", "10.134.142.226:22", 5*time.Second, 2*time.Second)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if _, ok := conn.(*gracefulConn); ok {
+		t.Fatalf("fast dial should return the real connection")
+	}
+	conn.Close()
+}
+
+func TestDialWithGraceSlowDialIsDeferred(t *testing.T) {
+	d := newTestDialer(300*time.Millisecond, nil)
+	start := time.Now()
+	conn, err := dialWithGrace(context.Background(), d, "tcp", "10.134.142.226:22", 3*time.Second, 50*time.Millisecond)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	elapsed := time.Since(start)
+	if elapsed > 250*time.Millisecond {
+		t.Fatalf("reply was not sent early, took %s", elapsed)
+	}
+	if _, ok := conn.(*gracefulConn); !ok {
+		t.Fatalf("slow dial should be deferred, got %T", conn)
+	}
+	// First Read must block until the tunnel finished the handshake.
+	buf := make([]byte, 1)
+	if _, err := conn.Read(buf); err != nil {
+		t.Fatalf("deferred conn read failed: %v", err)
+	}
+	conn.Close()
+}
+
+func TestDialWithGracePropagatesDialError(t *testing.T) {
+	d := newTestDialer(200*time.Millisecond, errors.New("network is unreachable"))
+	conn, err := dialWithGrace(context.Background(), d, "tcp", "10.134.142.226:22", 5*time.Second, 50*time.Millisecond)
+	if err != nil {
+		t.Fatalf("expected deferred conn, got error: %v", err)
+	}
+	if _, err := conn.Read(make([]byte, 1)); err == nil {
+		t.Fatalf("expected dial error on first read")
+	}
+	conn.Close()
+}
+
+func TestDialWithGraceCloseCancelsDial(t *testing.T) {
+	d := newTestDialer(10*time.Second, nil)
+	conn, err := dialWithGrace(context.Background(), d, "tcp", "10.134.142.226:22", 30*time.Second, 50*time.Millisecond)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	_ = conn.Close()
+	start := time.Now()
+	if _, err := conn.Read(make([]byte, 1)); err == nil {
+		t.Fatalf("expected error after close")
+	}
+	if time.Since(start) > 2*time.Second {
+		t.Fatalf("close did not cancel the in-flight dial")
+	}
+}
+
+func TestDialWithGraceConnectTimeout(t *testing.T) {
+	d := newTestDialer(10*time.Second, nil)
+	start := time.Now()
+	conn, err := dialWithGrace(context.Background(), d, "tcp", "10.134.142.226:22", 120*time.Millisecond, 20*time.Millisecond)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if _, err := conn.Read(make([]byte, 1)); err == nil {
+		t.Fatalf("expected timeout error")
+	}
+	if elapsed := time.Since(start); elapsed > 2*time.Second {
+		t.Fatalf("connect timeout not honoured, took %s", elapsed)
+	}
+	conn.Close()
+}
+
+// Regression: gonet.DialContextTCP returns a typed-nil conn together with the
+// error; the deferred Close in go-socks5 must not panic on it.
+func TestDialWithGraceTypedNilConnDoesNotPanic(t *testing.T) {
+	d := dial.NewDialer(&fakeStack{delay: 150 * time.Millisecond, typedNilWithErr: true}, nil, nil, true, "")
+	conn, err := dialWithGrace(context.Background(), d, "tcp", "10.134.142.226:22", 5*time.Second, 20*time.Millisecond)
+	if err != nil {
+		t.Fatalf("expected deferred conn, got error: %v", err)
+	}
+	if _, err := conn.Read(make([]byte, 1)); err == nil {
+		t.Fatalf("expected dial error")
+	}
+	conn.Close() // must not panic
+}
+
+// Regression: the SOCKS5 reply serialises LocalAddr(); a nil IP would produce a
+// truncated reply and make the client hang until its own timeout.
+func TestGracefulConnLocalAddrIsValidIPv4(t *testing.T) {
+	d := newTestDialer(10*time.Second, nil)
+	conn, err := dialWithGrace(context.Background(), d, "tcp", "10.134.142.226:22", 30*time.Second, 20*time.Millisecond)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	addr, ok := conn.LocalAddr().(*net.TCPAddr)
+	if !ok {
+		t.Fatalf("unexpected LocalAddr type %T", conn.LocalAddr())
+	}
+	if addr.IP.To4() == nil || len(addr.IP.To4()) != net.IPv4len {
+		t.Fatalf("LocalAddr must be a valid IPv4 for the SOCKS5 reply, got %v", addr.IP)
+	}
+	_ = conn.Close()
+}
+
+// flakyStack fails the first N handshake attempts, then succeeds.
+type flakyStack struct {
+	failFirst int
+	attempts  int32
+}
+
+func (f *flakyStack) Run()                             {}
+func (f *flakyStack) SetupResolve(_ zcdns.LocalServer) {}
+
+func (f *flakyStack) DialTCPContext(ctx context.Context, addr *net.TCPAddr) (net.Conn, error) {
+	n := atomic.AddInt32(&f.attempts, 1)
+	if int(n) <= f.failFirst {
+		return nil, errors.New("syn lost")
+	}
+	client, server := net.Pipe()
+	go func() {
+		_, _ = server.Write([]byte{'x'})
+	}()
+	return client, nil
+}
+
+func (f *flakyStack) DialTCP(addr *net.TCPAddr) (net.Conn, error) {
+	return f.DialTCPContext(context.Background(), addr)
+}
+
+func (f *flakyStack) DialUDP(addr *net.UDPAddr) (net.Conn, error) { return nil, errors.New("no udp") }
+
+// A wedged handshake must be replaced by a fresh attempt (new gVisor endpoint /
+// source port), which is what recovers from RVPN's short stalls.
+func TestDialWithGraceRetriesWedgedHandshake(t *testing.T) {
+	fs := &flakyStack{failFirst: 2}
+	d := dial.NewDialer(fs, nil, nil, true, "")
+	conn, err := dialWithGrace(context.Background(), d, "tcp", "10.134.142.226:22", 5*time.Second, 20*time.Millisecond)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	buf := make([]byte, 1)
+	if _, err := conn.Read(buf); err != nil {
+		t.Fatalf("expected success after retries, got %v", err)
+	}
+	if got := atomic.LoadInt32(&fs.attempts); got != 3 {
+		t.Fatalf("expected 3 attempts, got %d", got)
+	}
+	_ = conn.Close()
+}
+
+func TestDialWithGraceRetryBudgetIsRespected(t *testing.T) {
+	fs := &flakyStack{failFirst: 1000}
+	d := dial.NewDialer(fs, nil, nil, true, "")
+	start := time.Now()
+	conn, err := dialWithGrace(context.Background(), d, "tcp", "10.134.142.226:22", 700*time.Millisecond, 20*time.Millisecond)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if _, err := conn.Read(make([]byte, 1)); err == nil {
+		t.Fatalf("expected failure")
+	}
+	if elapsed := time.Since(start); elapsed > 3*time.Second {
+		t.Fatalf("retry budget not respected, took %s", elapsed)
+	}
+	_ = conn.Close()
+}
